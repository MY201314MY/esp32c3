/ {
    chosen {
        zephyr,console = &usb_serial;
        zephyr,shell-uart = &usb_serial;
    };

	aliases {
		modem = &modem;
		uart-mux = &uart_mux;
		internal-flash-storage = &flash;
	};

	/* gpio output */
	led: led {
		compatible = "gpio-leds";

		uart_mux: uart_mux {
			gpios = <&gpio0 10 GPIO_ACTIVE_HIGH>;
		};
	};
};

&flash0 {
	status = "okay";
};

&usb_serial {
    status = "okay";
};

&pinctrl {
	uart1_default: uart1_default {
		group1 {
			pinmux = <UART1_TX_GPIO5>;
			output-high;
		};
		group2 {
			pinmux = <UART1_RX_GPIO7>;
			bias-pull-up;
		};
	};

	i2c0_default: i2c0_default {
		group1 {
			pinmux = <I2C0_SDA_GPIO6>, <I2C0_SCL_GPIO7>;
			bias-pull-up;
			drive-open-drain;
			output-high;
		};
	};

};

&uart1 {
    pinctrl-0 = <&uart1_default>;
    pinctrl-names = "default";
    status = "okay";
};

&uart0 {
	modem: modem {
		compatible = "telit,cellular-modem";
		status = "okay";

		mdm-power-gpios = <&gpio0 8 GPIO_ACTIVE_HIGH>;
	};
};


&i2c0 {
	status = "okay";
	clock-frequency = <I2C_BITRATE_STANDARD>;
	pinctrl-0 = <&i2c0_default>;
	pinctrl-names = "default";

	et64c16: et64c16@20 {
		status = "okay";
		compatible = "tc,et64c16";
		reg = <0x20>;
		ngpios = <16>;
		#gpio-cells = <2>;
		gpio-controller;
	};
};
